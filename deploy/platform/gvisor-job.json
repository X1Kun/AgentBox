{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "__NAME__",
    "namespace": "agentbox-platform",
    "labels": {
      "agentbox.dev/session": "__SESSION__"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 180,
    "completions": 1,
    "parallelism": 1,
    "template": {
      "metadata": {
        "labels": {
          "agentbox.dev/session": "__SESSION__"
        }
      },
      "spec": {
        "runtimeClassName": "agentbox-gvisor",
        "restartPolicy": "Never",
        "terminationGracePeriodSeconds": 3,
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "agentbox.dev/lab": "agentbox-platform-lab",
          "agentbox.dev/role": "worker"
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "compute",
            "image": "__IMAGE__",
            "imagePullPolicy": "IfNotPresent",
            "command": [],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "work",
                "mountPath": "/work"
              },
              {
                "name": "work",
                "mountPath": "/tmp"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "work",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "16Mi"
            }
          }
        ]
      }
    }
  }
}
