[Unit]
Description=AgentBox local API gateway
Requires=agentbox.service
After=agentbox.service

[Service]
Type=notify
NotifyAccess=main
User=agentbox-gateway
Group=agentbox-gateway
WorkingDirectory=/opt/agentbox
Environment=AGENTBOX_GATEWAY_LISTEN=127.0.0.1:8080 AGENTBOX_GATEWAY_MAX_INFLIGHT=8 AGENTBOX_GATEWAY_TIMEOUT=50s
EnvironmentFile=/etc/agentbox-gateway.env
ExecStart=/opt/agentbox/bin/agentbox-gateway -listen ${AGENTBOX_GATEWAY_LISTEN} -daemon-socket /run/agentbox/daemon.sock -max-inflight ${AGENTBOX_GATEWAY_MAX_INFLIGHT} -request-timeout ${AGENTBOX_GATEWAY_TIMEOUT}
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=64
TimeoutStartSec=10
TimeoutStopSec=10
Restart=no

[Install]
WantedBy=multi-user.target
