(p.ready)\n   p.adjustInventoryLocked(at)\n   refill()\n   p.adjustInventoryLocked(at.Add(time.Millisecond)) // establish idle baseline\n   t.Logf(\"request=%d logical_gap=10s ready_before_decision=%d queued=%d executing=%d target_before=%d target_after=%d\",request,readyBefore,len(p.waiters),p.executing,before,p.inventory.Target)\n  }\n  if p.inventory.Target!=3 || p.telemetry.QueueEntered!=0 || p.inventory.ScaleUps!=2 {t.Fatalf(\"unexpected state: %+v\",p.inventory)}\n })\n}\n",
